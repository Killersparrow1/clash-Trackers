+package com.killersparrow1.clashtrackers.core
+
+/** One upgrade worth starting before bed. */
+data class BedtimePick(
+    val category: JobCategory,
+    val dataId: Int,
+    /** Level it would be upgraded to (1 = a new building). */
+    val toLevel: Int,
+    val seconds: Long,
+    /** Lasts at least as long as the sleep window, so the builder is not idle before you wake. */
+    val coversNight: Boolean,
+)
+
+/** A builder, the lab or the pet house that is idle now or will be before you wake. */
+data class BedtimeSlot(
+    val category: JobCategory,
+    /** Seconds until it is free; 0 = free now. */
+    val freeInSeconds: Long,
+    /** Seconds it would sit idle before [windowSeconds] ends if nothing is started. */
+    val idleSeconds: Long,
+    val pick: BedtimePick?,
+)
+
+data class BedtimeResult(val windowSeconds: Long, val slots: List<BedtimeSlot>)
+
+/**
+ * "Bedtime Lvl Up": for every builder, the lab and the pet house that is free now, or frees up
+ * before you wake, suggests the next upgrade that keeps it busy all night: the shortest one at least
+ * as long as the sleep window, or the longest available if none is that long.
+ * Resources and building prerequisites are not checked.
+ */
+object Bedtime {
+
+    fun compute(
+        export: VillageExport,
+        model: WidgetModel,
+        nowSec: Long,
+        windowSeconds: Long,
+        max: MaxData,
+        times: UpgradeTimes,
+    ): BedtimeResult {
+        val wake = nowSec + windowSeconds
+        val candidates = nextUpgrades(export, nowSec, max, times)
+
+        fun slotsFor(category: JobCategory, running: List<WidgetRow>, total: Int): List<BedtimeSlot> {
+            val busy = running.filter { it.kind == RowKind.RUNNING && it.finishAt != null }.map { (it.finishAt!! - nowSec).coerceAtLeast(0) }
+            val free = (total - busy.size).coerceAtLeast(0)
+            val freeIn = List(free) { 0L } + busy.filter { it < windowSeconds }
+            val pool = candidates[category].orEmpty().toMutableList()
+            return freeIn.sorted().map { inSec ->
+                val need = windowSeconds - inSec
+                val chosen = choose(pool, need)?.also { pool.remove(it) }
+                BedtimeSlot(category, inSec, need.coerceAtLeast(0), chosen?.copy(coversNight = chosen.seconds >= need))
+            }
+        }
+
+        val slots = buildList {
+            addAll(slotsFor(JobCategory.BUILDER, model.builderRows.filter { !it.goblin }, model.buildersTotal))
+            addAll(slotsFor(JobCategory.LAB, listOf(model.labRow), 1))
+            addAll(slotsFor(JobCategory.PET, listOf(model.petRow), 1))
+        }
+        return BedtimeResult(windowSeconds, slots)
+    }
+
+    private fun choose(pool: List<BedtimePick>, needSeconds: Long): BedtimePick? {
+        if (pool.isEmpty()) return null
+        return pool.filter { it.seconds >= needSeconds }.minByOrNull { it.seconds } ?: pool.maxByOrNull { it.seconds }
+    }
+
+    /** The next level of every copy that is not being upgraded and is below its maximum, plus buildings still to build. */
+    internal fun nextUpgrades(export: VillageExport, nowSec: Long, max: MaxData, times: UpgradeTimes): Map<JobCategory, List<BedtimePick>> {
+        val result = mutableMapOf<JobCategory, MutableList<BedtimePick>>()
+        val homeCategories = setOf(JobCategory.BUILDER, JobCategory.LAB, JobCategory.PET)
+        for ((id, owned) in export.items.filter { it.category in homeCategories }.groupBy { it.dataId }) {
+            val item = max[id] ?: continue
+            val th = export.townHallLevel ?: continue
+            val top = item.maxLevel(th)
+            if (top == 0) continue
+            val category = owned.first().category
+            val list = result.getOrPut(category) { mutableListOf() }
+            for (o in owned.filter { it.upgradeRemaining == null && it.level < top }) {
+                val t = times.timeTo(id, o.level + 1)?.takeIf { it > 0 } ?: continue
+                repeat(o.count.coerceAtMost(MAX_COPIES)) { list += BedtimePick(category, id, o.level + 1, t, false) }
+            }
+            val have = owned.sumOf { it.count }
+            val missing = if (item.merges) 0 else ((item.countAt(th) ?: have) - have).coerceAtLeast(0)
+            val build = times.timeTo(id, 1)?.takeIf { it > 0 }
+            if (build != null) repeat(missing.coerceAtMost(MAX_COPIES)) { list += BedtimePick(category, id, 1, build, false) }
+        }
+        return result
+    }
+
+    private const val MAX_COPIES = 12
+}
