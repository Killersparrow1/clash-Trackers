+package com.killersparrow1.clashtrackers.core
+
+import kotlinx.serialization.json.Json
+import kotlinx.serialization.json.JsonArray
+import kotlinx.serialization.json.JsonObject
+import kotlinx.serialization.json.JsonPrimitive
+import kotlinx.serialization.json.intOrNull
+import kotlinx.serialization.json.jsonObject
+
+/**
+ * Which level each item may reach at a given Town Hall (Home Village) or Builder Hall (Builder Base),
+ * from the bundled `assets/max_levels.json` (see `tools/gen_max_levels.cjs`).
+ *
+ * @param requirements hall level needed for level `i + 1` at index `i`.
+ * @param counts how many of a building or trap each hall level allows; empty for troops and heroes.
+ * @param merges true when merging can lower the number owned (Town Hall 16+ defenses), so a missing one is not "left to build".
+ */
+class MaxItem(
+    val builderBase: Boolean,
+    private val requirements: IntArray,
+    private val counts: Map<Int, Int>,
+    val merges: Boolean,
+) {
+    /** Highest level allowed at [hall]; 0 when the item is not available yet. */
+    fun maxLevel(hall: Int): Int = requirements.indexOfLast { it <= hall } + 1
+
+    /** How many are allowed at [hall] (the nearest lower entry when [hall] has none), or null for items without a count. */
+    fun countAt(hall: Int): Int? = counts.entries.filter { it.key <= hall }.maxByOrNull { it.key }?.value
+}
+
+class MaxData(private val items: Map<Int, MaxItem>) {
+    val size: Int get() = items.size
+    operator fun get(dataId: Int): MaxItem? = items[dataId]
+
+    companion object {
+        val EMPTY = MaxData(emptyMap())
+
+        fun fromJson(text: String): MaxData {
+            val root = Json.parseToJsonElement(text).jsonObject
+            val obj = root["items"] as? JsonObject ?: return EMPTY
+            return MaxData(
+                obj.entries.mapNotNull { (id, v) ->
+                    val key = id.toIntOrNull() ?: return@mapNotNull null
+                    val o = v as? JsonObject ?: return@mapNotNull null
+                    val req = (o["r"] as? JsonArray)?.map { (it as? JsonPrimitive)?.intOrNull ?: Int.MAX_VALUE }
+                        ?: return@mapNotNull null
+                    val counts = (o["n"] as? JsonObject)?.entries?.mapNotNull { (h, c) ->
+                        val hall = h.toIntOrNull() ?: return@mapNotNull null
+                        val n = (c as? JsonPrimitive)?.intOrNull ?: return@mapNotNull null
+                        hall to n
+                    }?.toMap().orEmpty()
+                    key to MaxItem(
+                        builderBase = (o["b"] as? JsonPrimitive)?.intOrNull == 1,
+                        requirements = req.toIntArray(),
+                        counts = counts,
+                        merges = (o["m"] as? JsonPrimitive)?.intOrNull == 1,
+                    )
+                }.toMap()
+            )
+        }
+    }
+}
