+@Composable
+private fun EntryRow(entry: MaxEntry, model: WidgetModel, nameOf: (Int) -> String) {
+    Row(Modifier.fillMaxWidth(), horizontalArrangement = Arrangement.SpaceBetween, verticalAlignment = Alignment.CenterVertically) {
+        Column(Modifier.weight(1f).padding(end = 12.dp)) {
+            val copies = entry.behind + entry.toBuild
+            Text(if (copies > 1) "${nameOf(entry.dataId)} ×$copies" else nameOf(entry.dataId), style = MaterialTheme.typography.bodyLarge)
