+
+/** The Plan tab: "Road to max" (everything left for the current Town Hall) and "Bedtime Lvl Up". */
+@Composable
+fun PlanScreen(state: AppState, model: WidgetModel, now: Long) {
+    var tab by rememberSaveable { mutableIntStateOf(0) }
+    Column(Modifier.fillMaxSize()) {
+        PrimaryTabRow(selectedTabIndex = tab) {
+            Tab(selected = tab == 0, onClick = { tab = 0 }, text = { Text(stringResource(R.string.plan_tab_road)) })
+            Tab(selected = tab == 1, onClick = { tab = 1 }, text = { Text(stringResource(R.string.plan_tab_bedtime)) })
+        }
+        if (state.export == null) {
+            Text(
+                stringResource(R.string.plan_no_data),
+                style = MaterialTheme.typography.bodyLarge,
+                modifier = Modifier.padding(24.dp),
+            )
+        } else if (tab == 0) {
+            RoadToMaxTab(state, model, now)
+        } else {
+            BedtimeTab(state, model, now)
+        }
+    }
+}
+
+private fun groupTitle(category: JobCategory): Int = when (category) {
+    JobCategory.BUILDER -> R.string.plan_group_builder
+    JobCategory.LAB -> R.string.plan_group_lab
+    JobCategory.PET -> R.string.plan_group_pet
+    JobCategory.BB_BUILDER -> R.string.plan_group_bb
+    JobCategory.STAR_LAB -> R.string.plan_group_starlab
+}
+
+@Composable
+private fun RoadToMaxTab(state: AppState, model: WidgetModel, now: Long) {
+    val context = LocalContext.current
+    val names = Names.get(context)
+    val export = state.export ?: return
+    val nowMinute = now / 60
+    val result = remember(state.exportJson, nowMinute) {
+        RoadToMax.compute(export, nowMinute * 60, MaxLevels.get(context), Times.get(context))
+    }
+    LazyColumn(
+        contentPadding = PaddingValues(16.dp),
+        verticalArrangement = Arrangement.spacedBy(12.dp),
+        modifier = Modifier.fillMaxSize(),
+    ) {
+        item {
+            Card(Modifier.fillMaxWidth(), colors = CardDefaults.cardColors(containerColor = MaterialTheme.colorScheme.primaryContainer)) {
+                Column(Modifier.padding(16.dp)) {
+                    if (result.groups.isEmpty()) {
+                        Text(stringResource(R.string.plan_maxed), style = MaterialTheme.typography.titleMedium)
+                    } else {
+                        Text(model.text.formatRemaining(result.seconds), style = MaterialTheme.typography.headlineMedium)
+                        Text(stringResource(R.string.plan_total_label), style = MaterialTheme.typography.bodyMedium)
+                    }
+                }
+            }
+        }
+        items(result.groups) { group ->
+            GroupCard(group, model, names::name, export.derivedTotalBuilders)
+        }
+        item {
+            Text(
+                stringResource(if (result.incomplete) R.string.plan_road_note_incomplete else R.string.plan_road_note),
+                style = MaterialTheme.typography.bodySmall,
+                modifier = Modifier.padding(horizontal = 4.dp),
+            )
+        }
+    }
+}
