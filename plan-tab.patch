+            Row(Modifier.fillMaxWidth(), horizontalArrangement = Arrangement.SpaceBetween, verticalAlignment = Alignment.CenterVertically) {
+                Text(stringResource(groupTitle(group.category)), style = MaterialTheme.typography.titleMedium)
+                Text(model.text.formatRemaining(group.seconds), style = MaterialTheme.typography.titleMedium)
+            }
+            if (group.category == JobCategory.BUILDER && builders != null && builders > 1) {
+                Text(
+                    stringResource(R.string.plan_builders_split, model.text.formatRemaining(group.seconds / builders), builders),
+                    style = MaterialTheme.typography.bodySmall,
+                )
+            }
+            HorizontalDivider()
+            group.entries.forEach { EntryRow(it, model, nameOf) }
