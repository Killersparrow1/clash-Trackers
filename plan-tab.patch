+
+@Composable
+private fun SlotCard(slot: BedtimeSlot, model: WidgetModel, nameOf: (Int) -> String) {
+    Card(Modifier.fillMaxWidth()) {
+        Column(Modifier.padding(16.dp), verticalArrangement = Arrangement.spacedBy(4.dp)) {
+            Row(Modifier.fillMaxWidth(), horizontalArrangement = Arrangement.SpaceBetween) {
+                Text(stringResource(groupTitle(slot.category)), style = MaterialTheme.typography.titleMedium)
+                Text(
+                    if (slot.freeInSeconds <= 0) stringResource(R.string.plan_free_now)
+                    else stringResource(R.string.plan_free_in, model.text.formatRemaining(slot.freeInSeconds)),
+                    style = MaterialTheme.typography.bodyMedium,
+                )
+            }
+            val pick = slot.pick
+            if (pick == null) {
+                Text(stringResource(R.string.plan_nothing_to_start), style = MaterialTheme.typography.bodyMedium)
+            } else {
+                val target = if (pick.toLevel == 1) stringResource(R.string.plan_new_building) else "→ ${pick.toLevel}"
+                Text("${nameOf(pick.dataId)} $target · ${model.text.formatRemaining(pick.seconds)}", style = MaterialTheme.typography.bodyLarge)
+                Text(
+                    stringResource(if (pick.coversNight) R.string.plan_covers_night else R.string.plan_ends_early),
+                    style = MaterialTheme.typography.bodySmall,
+                    color = if (pick.coversNight) MaterialTheme.colorScheme.primary else MaterialTheme.colorScheme.error,
+                )
+            }
+        }
+    }
+}
