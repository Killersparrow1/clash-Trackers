+    val export = state.export ?: return
+    var hours by rememberSaveable { mutableIntStateOf(8) }
+    val nowMinute = now / 60
+    val result = remember(state.exportJson, nowMinute, hours, model.nextChangeAt) {
+        Bedtime.compute(export, model, nowMinute * 60, hours * 3600L, MaxLevels.get(context), Times.get(context))
+    }
+    LazyColumn(
+        contentPadding = PaddingValues(16.dp),
+        verticalArrangement = Arrangement.spacedBy(12.dp),
