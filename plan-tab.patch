@@ -0,0 +1,88 @@
+package com.killersparrow1.clashtrackers.core
+
+/** What is left on one kind of item (all copies of one building, one troop, ...). */
+data class MaxEntry(
+    val dataId: Int,
+    val category: JobCategory,
+    /** How many are owned (including any under construction). */
+    val owned: Int,
+    /** How many more must still be built to reach the hall's allowance. */
+    val toBuild: Int,
+    /** Lowest level among the copies owned, or 0 when none is owned yet. */
+    val lowestLevel: Int,
+    val maxLevel: Int,
+    /** Copies still below [maxLevel], not counting ones to build. */
+    val behind: Int,
+    /** Time for everything left on this item, one after another, in seconds. */
+    val seconds: Long,
+)
+
+data class MaxGroup(val category: JobCategory, val entries: List<MaxEntry>) {
+    val seconds: Long get() = entries.sumOf { it.seconds }
+}
+
+data class RoadToMaxResult(
+    /** Town Hall (or Builder Hall for the Builder Base groups) the maximum is worked out for. */
+    val townHall: Int?,
+    val builderHall: Int?,
+    val groups: List<MaxGroup>,
+    /** True when some upgrade had no time in the bundled data, so totals are a little short. */
+    val incomplete: Boolean,
+) {
+    val seconds: Long get() = groups.sumOf { it.seconds }
+}
+
+/**
+ * "Road to max": every upgrade still missing before the whole village is maxed for its current Town Hall
+ * (and the Builder Base for its Builder Hall). Times are base durations: potions, helpers and the
+ * Gold Pass are not applied, so they overstate what a boosted player will really wait.
+ * Supercharges, walls, hero equipment and crafted-defense modules are not counted.
+ */
+object RoadToMax {
+
+    fun compute(export: VillageExport, nowSec: Long, max: MaxData, times: UpgradeTimes): RoadToMaxResult {
+        val th = export.townHallLevel
+        val bh = export.builderHallLevel
+        var incomplete = false
+        val elapsed = (nowSec - export.timestamp).coerceAtLeast(0)
+
+        /** Time for levels [from]..[to] of [id]. */
+        fun span(id: Int, from: Int, to: Int): Long {
+            var sum = 0L
+            for (l in from..to) {
+                val t = times.timeTo(id, l)
+                if (t == null) incomplete = true else sum += t
+            }
+            return sum
+        }
+
+        val groups = JobCategory.entries.mapNotNull { category ->
+            val entries = export.items.filter { it.category == category }.groupBy { it.dataId }.mapNotNull { (id, owned) ->
+                val item = max[id] ?: return@mapNotNull null
+                val hall = (if (item.builderBase) bh else th) ?: return@mapNotNull null
+                val top = item.maxLevel(hall)
+                if (top == 0) return@mapNotNull null
+
+                var seconds = 0L
+                var behind = 0
+                for (o in owned) {
+                    if (o.level >= top) continue
+                    behind += o.count
+                    val perCopy = if (o.upgradeRemaining != null) {
+                        (o.upgradeRemaining - elapsed).coerceAtLeast(0) + span(id, o.level + 2, top)
+                    } else {
+                        span(id, o.level + 1, top)
+                    }
+                    seconds += perCopy * o.count
+                }
+                val have = owned.sumOf { it.count }
+                val toBuild = if (item.merges) 0 else ((item.countAt(hall) ?: have) - have).coerceAtLeast(0)
+                if (toBuild > 0) seconds += toBuild * span(id, 1, top)
+                if (behind == 0 && toBuild == 0) return@mapNotNull null
+                MaxEntry(id, category, have, toBuild, owned.minOf { it.level }, top, behind, seconds)
+            }.sortedByDescending { it.seconds }
+            if (entries.isEmpty()) null else MaxGroup(category, entries)
+        }
+        return RoadToMaxResult(th, bh, groups, incomplete)
+    }
+}
