diff --git a/app/src/test/java/com/killersparrow1/clashtrackers/core/PlanTest.kt b/app/src/test/java/com/killersparrow1/clashtrackers/core/PlanTest.kt
new file mode 100644
index 0000000..0bccc0f
--- /dev/null
+++ b/app/src/test/java/com/killersparrow1/clashtrackers/core/PlanTest.kt
@@ -0,0 +1,121 @@
+package com.killersparrow1.clashtrackers.core
+
+import com.killersparrow1.clashtrackers.core.SampleExports.export2
+import com.killersparrow1.clashtrackers.core.SampleExports.export4
+import com.killersparrow1.clashtrackers.core.SampleExports.names
+import com.killersparrow1.clashtrackers.core.SampleExports.times
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNotNull
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/** The Plan tab: what is left to max the village (Road to max) and what to start before bed (Bedtime Lvl Up). */
+class PlanTest {
+
+    private val max: MaxData by lazy {
+        MaxData.fromJson(SampleExports.file("src/main/assets/max_levels.json", "app/src/main/assets/max_levels.json").readText())
+    }
+
+    // A made-up item: levels 1-2 need Town Hall 1, level 3 needs TH 2, level 4 needs TH 3; TH 2 allows two of them.
+    private val tinyMax = MaxData.fromJson("""{"items":{"1":{"b":0,"r":[1,1,2,3],"n":{"1":1,"2":2}}}}""")
+    private val tinyTimes = UpgradeTimes.fromJson("""{"times":{"1":{"1":100,"2":200,"3":300,"4":400}}}""")
+
+    private fun village(vararg items: OwnedItem, th: Int = 2) = VillageExport(
+        tag = "#TEST", timestamp = 1_000, townHallLevel = th, builderHutCount = 5,
+        helpers = emptyList(), jobs = emptyList(), items = items.toList(),
+    )
+
+    @Test fun parserKeepsEveryItemAndBuilderHall() {
+        assertEquals(10, export2.builderHallLevel)
+        assertTrue(export2.items.size > 150)
+        assertTrue(export2.items.any { it.dataId == GameIds.TOWN_HALL && it.level == 18 })
+        // A running upgrade keeps its timer; plain items do not have one.
+        assertTrue(export2.items.any { it.upgradeRemaining != null })
+        assertTrue(export2.items.any { it.upgradeRemaining == null })
+    }
+
+    @Test fun maxLevelsFollowTheHall() {
+        val cannon = max[1000008]!!
+        assertEquals(21, cannon.maxLevel(18))
+        assertEquals(7, cannon.countAt(18))
+        assertTrue(cannon.merges)
+        assertEquals(0, tinyMax[1]!!.maxLevel(0))
+        assertEquals(2, tinyMax[1]!!.maxLevel(1))
+        assertEquals(3, tinyMax[1]!!.maxLevel(2))
+        assertEquals(1, tinyMax[1]!!.countAt(1))
+        assertEquals(2, tinyMax[1]!!.countAt(5)) // beyond the last entry: the nearest lower one
+    }
+
+    @Test fun everyItemInTheSamplesHasMaxDataExceptHallsWallsAndBuilderBaseCamps() {
+        val knownSkipped = setOf(1000001, 1000010, 1000033, 1000034, 1000042, 1000049)
+        for (e in listOf(export2, export4)) {
+            val missing = e.items.map { it.dataId }.toSet().filter { max[it] == null && it !in knownSkipped }
+            assertEquals("items without max data: $missing", emptyList<Int>(), missing)
+        }
+    }
+
+    @Test fun roadToMaxAddsUpgradesAndBuildingsStillToBuild() {
+        // One copy at level 1, TH 2 allows two and level 3: 200 + 300 to upgrade, plus 100 + 200 + 300 for the second copy.
+        val r = RoadToMax.compute(village(OwnedItem(JobCategory.BUILDER, 1, 1)), 1_000, tinyMax, tinyTimes)
+        val entry = r.groups.single().entries.single()
+        assertEquals(1100L, entry.seconds)
+        assertEquals(1, entry.toBuild)
+        assertEquals(1, entry.behind)
+        assertEquals(3, entry.maxLevel)
+        assertFalse(r.incomplete)
+    }
+
+    @Test fun roadToMaxUsesTheRemainingTimeOfARunningUpgrade() {
+        // Level 1 → 2 has 150 s left at the export; 50 s later 100 s are left, then level 3 takes 300 s; the second copy 600 s.
+        val r = RoadToMax.compute(village(OwnedItem(JobCategory.BUILDER, 1, 1, upgradeRemaining = 150)), 1_050, tinyMax, tinyTimes)
+        assertEquals(1000L, r.seconds)
+    }
+
+    @Test fun roadToMaxIsEmptyWhenEverythingIsMaxed() {
+        val r = RoadToMax.compute(
+            village(OwnedItem(JobCategory.BUILDER, 1, 3, count = 2)), 1_000, tinyMax, tinyTimes,
+        )
+        assertTrue(r.groups.isEmpty())
+        assertEquals(0L, r.seconds)
+    }
+
+    @Test fun roadToMaxFlagsMissingTimes() {
+        val r = RoadToMax.compute(village(OwnedItem(JobCategory.BUILDER, 1, 1)), 1_000, tinyMax, UpgradeTimes.EMPTY)
+        assertTrue(r.incomplete)
+    }
+
+    @Test fun roadToMaxOnARealVillageHasEveryGroup() {
+        val r = RoadToMax.compute(export2, export2.timestamp, max, times)
+        assertEquals(JobCategory.entries.toSet(), r.groups.map { it.category }.toSet())
+        assertFalse(r.incomplete)
+        assertTrue(r.seconds > 0)
+        // Biggest first inside a group.
+        r.groups.forEach { g -> assertEquals(g.entries.sortedByDescending { it.seconds }, g.entries) }
+    }
+
+    @Test fun bedtimePicksAnUpgradeThatLastsTheNight() {
+        val now = export4.timestamp + 3600
+        val state = (SyncLogic.apply(AppState(), SampleExports.text("export_4.json")) as SyncLogic.Outcome.Synced).state
+        val model = WidgetModelBuilder.build(state, AppSettings(), names, times, now)
+        val window = 8 * 3600L
+        val result = Bedtime.compute(export4, model, now, window, max, times)
+        assertEquals(window, result.windowSeconds)
+        assertTrue(result.slots.isNotEmpty())
+        for (slot in result.slots) {
+            assertTrue(slot.freeInSeconds in 0 until window)
+            val pick = slot.pick ?: continue
+            assertEquals(pick.coversNight, pick.seconds >= window - slot.freeInSeconds)
+        }
+        // The lab and the pet house are idle in this export, so each gets a suggestion.
+        assertNotNull(result.slots.first { it.category == JobCategory.LAB }.pick)
+        assertNotNull(result.slots.first { it.category == JobCategory.PET }.pick)
+    }
+
+    @Test fun bedtimeWithNothingToUpgradeSuggestsNothing() {
+        val e = village(OwnedItem(JobCategory.LAB, 1, 3, count = 2))
+        val picks = Bedtime.nextUpgrades(e, 1_000, tinyMax, tinyTimes)
+        assertNull(picks[JobCategory.LAB]?.firstOrNull())
+    }
+}
diff --git a/tools/gen_max_levels.cjs b/tools/gen_max_levels.cjs
new file mode 100644
index 0000000..9d550e8
--- /dev/null
+++ b/tools/gen_max_levels.cjs
@@ -0,0 +1,69 @@
+// Generates app/src/main/assets/max_levels.json from the `clash-of-clans-data` npm package.
+// Usage (same unpacked tarball as gen_upgrade_times.cjs):
+//   node tools/gen_max_levels.cjs <path-to-unpacked>/package app/src/main/assets/max_levels.json
+//
+// Output: { "source": "...", "items": { "<dataId>": { "b": 0|1, "r": [req level 1, req level 2, ...], "n": {"<hall>": count} } } }
+//  b: 0 = Home Village (gated by Town Hall), 1 = Builder Base (gated by Builder Hall)
+//  r[i]: the hall level needed for level i+1 (heroes and Star Lab troops are converted to hall levels)
+//  n: how many the hall level allows (buildings and traps); "m": 1 when merging can lower the number owned
+// Supercharge levels, walls, hero equipment and crafted-defense modules are left out.
+const fs = require('fs'), path = require('path');
+const [pkgDir, outFile] = process.argv.slice(2);
+const version = JSON.parse(fs.readFileSync(path.join(pkgDir, 'package.json'), 'utf8')).version;
+const SKIP_DIRS = new Set(['walls', 'hero-equipment', 'crafted-defenses', 'leagues']);
+
+function load(base) {
+  const root = path.join(pkgDir, 'data', base), out = [];
+  (function walk(d) {
+    for (const f of fs.readdirSync(d).sort()) {
+      const p = path.join(d, f);
+      if (fs.statSync(p).isDirectory()) { if (!SKIP_DIRS.has(f)) walk(p); }
+      else if (p.endsWith('.json')) { const o = JSON.parse(fs.readFileSync(p, 'utf8')); (Array.isArray(o) ? o : [o]).forEach(x => out.push([x, base])); }
+    }
+  })(root);
+  return out;
+}
+const all = [...load('home'), ...load('builder')].filter(([o]) => o && typeof o.dataId === 'number' && Array.isArray(o.levels));
+const byId = new Map(all.map(([o]) => [o.dataId, o]));
+const find = id => (id && byId.get(id)) || null;
+const hallOf = (base, name) => all.map(([o]) => o).find(o => o.base === base && o.name === name);
+
+// Level of a helper building -> the hall level that unlocks it (Hero Hall for home heroes, Star Laboratory for Builder Base troops).
+const heroHall = hallOf('home', 'Hero Hall'), starLab = hallOf('builder', 'Star Laboratory');
+function viaBuilding(b, level, key) {
+  const l = b && b.levels.find(x => x.level === level);
+  return l ? l[key] : undefined;
+}
+
+const items = {}; const warnings = [];
+for (const [o, base] of all) {
+  const home = base === 'home';
+  const r = [];
+  for (const l of o.levels) {
+    if (l.supercharge !== undefined) continue;
+    let req;
+    if (home) {
+      req = l.townHallRequired;
+      if (req === undefined && l.heroHallLevelRequired !== undefined) req = viaBuilding(heroHall, l.heroHallLevelRequired, 'townHallRequired');
+    } else {
+      req = l.builderHallRequired;
+      if (req === undefined && l.builderHallLevelRequired !== undefined) req = l.builderHallLevelRequired;
+      if (req === undefined && l.starLabRequired !== undefined) req = viaBuilding(starLab, l.starLabRequired, 'builderHallRequired');
+    }
+    if (typeof req === 'number') r[l.level - 1] = req;
+  }
+  // A level with no requirement (a troop's starting level) takes the next known one.
+  for (let i = r.length - 2; i >= 0; i--) if (r[i] === undefined && r[i + 1] !== undefined) r[i] = r[i + 1];
+  if (!r.length || r.some(v => v === undefined)) { if (!/wall|equipment/i.test(o.category || '')) warnings.push(`${o.dataId} ${o.id}: no hall requirements, skipped`); continue; }
+  const item = { b: home ? 0 : 1, r };
+  const avail = o.availablePerTownHall || o.availablePerBuilderHall;
+  if (avail) {
+    item.n = Object.fromEntries(avail.map(a => [a.townHallLevel ?? a.builderHallLevel, a.count]));
+    if (avail.some(a => a.countAfterMerges !== undefined)) item.m = 1;
+  }
+  items[o.dataId] = item;
+}
+const sorted = Object.fromEntries(Object.keys(items).map(Number).sort((a, b) => a - b).map(k => [k, items[k]]));
+fs.writeFileSync(outFile, JSON.stringify({ source: `clash-of-clans-data@${version}`, items: sorted }) + '\n');
+console.error(`${Object.keys(sorted).length} items written, ${warnings.length} skipped`);
+warnings.slice(0, 15).forEach(w => console.error(' ' + w));
