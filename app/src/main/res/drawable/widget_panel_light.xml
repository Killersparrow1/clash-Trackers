<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <stroke android:width="2dp" android:color="#D5D9E0" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item android:left="12dp" android:right="12dp" android:top="2dp" android:gravity="top" android:height="1dp">
        <shape android:shape="rectangle"><solid android:color="#00FFFFFF" /></shape>
    </item>
</layer-list>
