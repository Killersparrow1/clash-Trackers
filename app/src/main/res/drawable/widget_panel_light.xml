<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:type="linear" android:centerY="0.3"
                android:startColor="#FFFDF8" android:centerColor="#F7EFE2" android:endColor="#EADCC7" />
            <stroke android:width="2dp" android:color="#C9BBA8" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item android:left="12dp" android:right="12dp" android:top="2dp" android:gravity="top" android:height="1dp">
        <shape android:shape="rectangle"><solid android:color="#66FFFFFF" /></shape>
    </item>
</layer-list>
