<?xml version="1.0" encoding="utf-8"?>
<!-- Clash theme: the original green progress bar (never follows the system accent). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle"><solid android:color="#00000000" /></shape>
    </item>
    <item android:id="@android:id/progress">
        <clip android:clipOrientation="horizontal" android:gravity="left">
            <shape android:shape="rectangle">
                <gradient android:angle="270" android:centerY="0.45"
                    android:startColor="#EBB9EC7A" android:centerColor="#EB8FD14F" android:endColor="#EB5F9A2C" />
                <corners android:radius="6dp" />
            </shape>
        </clip>
    </item>
</layer-list>
