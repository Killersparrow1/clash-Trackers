<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#15171B" />
            <stroke android:width="2dp" android:color="#2A2E36" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item android:left="12dp" android:right="12dp" android:top="2dp" android:gravity="top" android:height="1dp">
        <shape android:shape="rectangle"><solid android:color="#14FFFFFF" /></shape>
    </item>
</layer-list>
