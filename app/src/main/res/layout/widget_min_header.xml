<?xml version="1.0" encoding="utf-8"?>
<!-- Minimal style: section label plus that section's potion / Bite chips (tap = add, "-" = undo). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="10dp"
    android:paddingBottom="4dp">

    <TextView
        android:id="@+id/mh_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="@font/doto"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="#8A8A8A"
        android:textSize="11dp" />

    <TextView
        android:id="@+id/mp_bite"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:background="@drawable/minimal_chip"
        android:fontFamily="@font/doto"
        android:includeFontPadding="false"
        android:paddingStart="8dp"
        android:paddingTop="3dp"
        android:paddingEnd="8dp"
        android:paddingBottom="3dp"
        android:textColor="#FFFFFF"
        android:textSize="11dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/mp_bite_undo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/doto"
        android:includeFontPadding="false"
        android:paddingStart="6dp"
        android:paddingTop="3dp"
        android:paddingEnd="2dp"
        android:paddingBottom="3dp"
        android:text="-"
        android:textColor="#8A8A8A"
        android:textSize="13dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/mp_soup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:background="@drawable/minimal_chip"
        android:fontFamily="@font/doto"
        android:includeFontPadding="false"
        android:paddingStart="8dp"
        android:paddingTop="3dp"
        android:paddingEnd="8dp"
        android:paddingBottom="3dp"
        android:textColor="#FFFFFF"
        android:textSize="11dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/mp_soup_undo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/doto"
        android:includeFontPadding="false"
        android:paddingStart="6dp"
        android:paddingTop="3dp"
        android:paddingEnd="2dp"
        android:paddingBottom="3dp"
        android:text="-"
        android:textColor="#8A8A8A"
        android:textSize="13dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/mp_bpot"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:background="@drawable/minimal_chip"
        android:fontFamily="@font/doto"
        android:includeFontPadding="false"
        android:paddingStart="8dp"
        android:paddingTop="3dp"
        android:paddingEnd="8dp"
        android:paddingBottom="3dp"
        android:textColor="#FFFFFF"
        android:textSize="11dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/mp_bpot_undo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/doto"
        android:includeFontPadding="false"
        android:paddingStart="6dp"
        android:paddingTop="3dp"
        android:paddingEnd="2dp"
        android:paddingBottom="3dp"
        android:text="-"
        android:textColor="#8A8A8A"
        android:textSize="13dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/mp_rpot"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:background="@drawable/minimal_chip"
        android:fontFamily="@font/doto"
        android:includeFontPadding="false"
        android:paddingStart="8dp"
        android:paddingTop="3dp"
        android:paddingEnd="8dp"
        android:paddingBottom="3dp"
        android:textColor="#FFFFFF"
        android:textSize="11dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/mp_rpot_undo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/doto"
        android:includeFontPadding="false"
        android:paddingStart="6dp"
        android:paddingTop="3dp"
        android:paddingEnd="2dp"
        android:paddingBottom="3dp"
        android:text="-"
        android:textColor="#8A8A8A"
        android:textSize="13dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/mp_ppot"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:background="@drawable/minimal_chip"
        android:fontFamily="@font/doto"
        android:includeFontPadding="false"
        android:paddingStart="8dp"
        android:paddingTop="3dp"
        android:paddingEnd="8dp"
        android:paddingBottom="3dp"
        android:textColor="#FFFFFF"
        android:textSize="11dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/mp_ppot_undo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/doto"
        android:includeFontPadding="false"
        android:paddingStart="6dp"
        android:paddingTop="3dp"
        android:paddingEnd="2dp"
        android:paddingBottom="3dp"
        android:text="-"
        android:textColor="#8A8A8A"
        android:textSize="13dp"
        android:visibility="gone" />
</LinearLayout>
