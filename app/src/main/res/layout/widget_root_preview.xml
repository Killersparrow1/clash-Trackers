                    android:fontFamily="sans-serif" android:text="+" android:textColor="#FFFFFF" android:textSize="15dp" android:textStyle="bold" />
            </FrameLayout>
            </LinearLayout>
        </FrameLayout>
        <FrameLayout android:layout_width="match_parent" android:layout_height="30dp" android:layout_marginBottom="3dp" android:background="@drawable/row_slot">
