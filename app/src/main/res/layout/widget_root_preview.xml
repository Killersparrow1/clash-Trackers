                <ImageView android:layout_width="13dp" android:layout_height="13dp" android:layout_marginEnd="5dp" android:src="@drawable/ic_sync" />
                <TextView style="@style/WidgetText" android:fontFamily="@font/lilita_one" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:shadowDy="0" android:shadowRadius="0" android:text="@string/widget_sync" android:textColor="@color/w_sync_text" android:textSize="13dp" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="2dp" android:layout_marginTop="4dp"
            android:layout_marginEnd="2dp" android:layout_marginBottom="3dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="2dp" android:paddingEnd="2dp">
