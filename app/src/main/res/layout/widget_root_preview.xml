            android:paddingStart="8dp" android:paddingEnd="8dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="@font/lilita_one"
                android:singleLine="true" android:text="Laboratory ➛ 16" android:textColor="@color/w_white" android:textSize="13.5dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/lilita_one"
                android:text="3d 9h" android:textColor="@color/w_white" android:textSize="13dp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="30dp" android:layout_marginBottom="3dp"
            android:background="@drawable/row_slot" android:gravity="center_vertical" android:orientation="horizontal"
            android:paddingStart="8dp" android:paddingEnd="8dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="@font/lilita_one"
                android:singleLine="true" android:text="Wizard Tower ➛ 17" android:textColor="@color/w_white" android:textSize="13.5dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/lilita_one"
                android:text="5d 2h" android:textColor="@color/w_white" android:textSize="13dp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="30dp" android:layout_marginBottom="3dp"
            android:background="@drawable/row_slot" android:gravity="center_vertical" android:orientation="horizontal"
            android:paddingStart="8dp" android:paddingEnd="8dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="@font/lilita_one"
                android:singleLine="true" android:text="Monkey King ➛ 90" android:textColor="@color/w_white" android:textSize="13.5dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/lilita_one"
                android:text="6d 0h" android:textColor="@color/w_white" android:textSize="13dp" />
