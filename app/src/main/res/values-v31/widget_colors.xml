    <color name="w_gold">@android:color/system_accent1_200</color>
    <color name="w_sub">@android:color/system_neutral2_200</color>
    <color name="w_goblin">@android:color/system_accent3_200</color>
    <color name="w_idle">@android:color/system_accent2_200</color>
    <color name="w_sync_text">@android:color/system_accent1_900</color>
</resources>
