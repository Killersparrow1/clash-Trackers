<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Exact alarms re-render the widget at countdown edges (day rollovers, finish times, boost
         edges). USE_EXACT_ALARM is granted at install on Android 13+; older versions use
         SCHEDULE_EXACT_ALARM. Without either, a 1-minute window alarm is used instead. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- "Builder free" notifications and rescheduling the alarms after a reboot. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- In-app update (Support > About): reads the latest GitHub release and installs its APK. Only used when you tap a button there. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Lets a notification tap open Clash of Clans (package visibility, Android 11+). -->
    <queries>
        <package android:name="com.supercell.clashofclans" />
    </queries>

    <application
        android:name=".ClashApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:localeConfig="@xml/locales_config"
        android:label="${appLabel}"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ClashTimer">
        <receiver
            android:name=".update.UpdateInstallReceiver"
            android:exported="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.ClashTimer"
            android:windowSoftInputMode="adjustResize" />

        <!-- Launcher entries (sync/AppIcon.kt); exactly one is enabled. "Themed" (the default) has the monochrome
             layer, so the phone's themed-icons setting decides. "Colour" never gets tinted. Developer options
             switches between them. -->
        <activity-alias
            android:name=".IconThemed"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:label="${appLabel}"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity-alias>
        <activity-alias
            android:name=".IconColour"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_colour"
            android:roundIcon="@mipmap/ic_launcher_colour_round"
            android:label="${appLabel}"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity-alias>

        <!-- R8 on/off for this build (app/build.gradle.kts), shown in crash reports. -->
        <meta-data
            android:name="com.killersparrow1.clashtrackers.R8"
            android:value="${r8}" />

        <!-- Crash screen (crash/CrashReporter.kt): own process, so it opens even when the main
             process is the one that died; own task, so "Close" doesn't return to a broken screen. -->
        <activity
            android:name=".crash.CrashActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:label="Clash Trackers crash"
            android:process=":crash"
            android:taskAffinity="${applicationId}.crash"
            android:theme="@style/Theme.ClashTimer" />

        <!-- Launched by the widget's Sync button: reads the clipboard once focused, then finishes. -->
        <activity
            android:name=".sync.SyncActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.ClashTimer.Invisible" />

        <!-- Clash Companion (companion/CompanionService.kt): window-change events only, switched on by the user in Accessibility settings. -->
        <service
            android:name=".companion.CompanionService"
            android:exported="false"
            android:label="@string/companion_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/companion_accessibility" />
        </service>

        <!-- Widget configuration activity for choosing an account -->
        <activity
            android:name=".widget.WidgetConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.ClashTimer">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Road to max widget (widget/RoadWidget.kt): its own small provider and a theme-only setup screen. -->
        <receiver
            android:name=".widget.RoadWidgetReceiver"
            android:exported="true"
            android:label="@string/road_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/road_widget_info" />
        </receiver>
        <activity
            android:name=".widget.RoadWidgetConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.ClashTimer">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Hero strip widget (widget/FlexWidgets.kt). It shares the Road to max setup screen. -->
        <receiver
            android:name=".widget.HeroWidgetReceiver"
            android:exported="true"
            android:label="@string/hero_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/hero_widget_info" />
        </receiver>

        <receiver android:name=".widget.HeroTapReceiver" android:exported="false" />

        <!-- Alerts for the Clash tab's events (notify/EventAlerts.kt). -->
        <receiver
            android:name=".notify.EventAlertReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Background check for a new app release (update/UpdateCheckJob.kt). -->
        <service
            android:name=".update.UpdateCheckJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <service
            android:name=".widget.WidgetListService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <receiver
            android:name=".widget.ClashWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <!-- Alarms are cleared by a reboot and depend on the clock: reschedule on these. -->
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/clash_widget_info" />
        </receiver>
    </application>

</manifest>
